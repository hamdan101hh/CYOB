{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/weekly-refresh",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/daily-refresh",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/cap-check",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/email/daily-summary",
      "schedule": "0 17 * * *"
    }
  ]
}
